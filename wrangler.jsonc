{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "manager-rocket-3000",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-02",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
